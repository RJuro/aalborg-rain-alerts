    {
      "id": "ef77b628-76c9-434a-ba65-94721be0c60d",
      "name": "Normalize management request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        650
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body ?? {};\nconst action = body.action;\nconst token = body.token;\nconst valid = ['confirm','unsubscribe'].includes(action) && typeof token === 'string' && /^[A-Za-z0-9_-]{43}$/.test(token);\nreturn [{json:{valid,action:valid ? action : '',token:valid ? token : '',token_column:action === 'unsubscribe' ? 'unsubscribe_token' : 'confirm_token'},pairedItem:{item:0}}];"
      }
    },
    {
      "id": "dca7dd06-c9f4-49a7-b6a8-6dec6500b98d",
      "name": "Find matching token",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        560,
        650
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "hrGw9PmDUB003kIY",
          "cachedResultName": "Aalborg rain subscribers"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "={{ $json.token_column }}",
              "condition": "eq",
              "keyValue": "={{ $json.token }}"
            }
          ]
        },
