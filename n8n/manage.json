    },
    {
      "id": "3ed7a8d1-026b-4d20-b18e-602f63dc6d3c",
      "name": "Build confirmation page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const query = $input.first().json.query ?? {};\nconst valid = ['confirm','unsubscribe'].includes(query.action) && /^[A-Za-z0-9_-]{43}$/.test(query.token ?? '');\nconst action = valid ? query.action : '';\nconst title = action === 'confirm' ? 'One click, then you are covered.' : action === 'unsubscribe' ? 'Leave the rain alerts?' : 'This link is incomplete.';\nconst button = action === 'confirm' ? 'Confirm my subscription' : 'Unsubscribe';\nconst form = valid ? '<form method=\"post\" action=\"https://n8n.automate.business.aau.dk/webhook/aalborg-rain-manage-v1\" target=\"_top\"><input type=\"hidden\" name=\"action\" value=\"' + action + '\"><input type=\"hidden\" name=\"token\" value=\"' + query.token + '\"><button type=\"submit\">' + button + '</button></form>' : '<p>Open the complete link from your email.</p>';\nconst html = '<!doctype html><html><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Aalborg Rain</title><style>body{background:#f5f2eb;color:#142e41;font:18px system-ui;margin:0;padding:10vh 8vw}main{max-width:620px;margin:auto}small{letter-spacing:.14em}h1{font:52px Georgia;line-height:1.1}button{background:#173f56;color:white;border:0;border-radius:8px;padding:16px 24px;font:inherit;cursor:pointer}p{line-height:1.7}</style><main><small>AALBORG RAIN</small><h1>' + title + '</h1><p>' + (action === 'confirm' ? 'Receive a heads-up when rain looks likely in the next six hours.' : 'You can subscribe again whenever you like.') + '</p>' + form + '</main></html>';\nreturn [{json:{html,status:valid ? 200 : 400},pairedItem:{item:0}}];"
      }
    },
    {
      "id": "b9dd2a81-1ecc-4974-8676-2985daa342df",
      "name": "Show confirmation page",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        560,
        200
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.html }}",
