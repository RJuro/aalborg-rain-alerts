    {
      "id": "3250a6ab-f28c-4fc7-9e84-ad0d105d566d",
      "name": "Choose confirmation action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const request = $('Validate signup').first().json;\nconst existing = $input.first().json;\nconst now = Date.now();\nconst recentlyRequested = existing.confirmation_requested_at && now - Date.parse(existing.confirmation_requested_at) < 15 * 60000;\nconst send_confirmation = !(existing.active && existing.confirmed) && !recentlyRequested;\nreturn [{json:{...request,send_confirmation,confirmation_requested_at:new Date(now).toISOString(),subscribed_at:existing.subscribed_at ?? new Date(now).toISOString()},pairedItem:{item:0}}];"
      }
    },
