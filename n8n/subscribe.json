        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "Confirm your Aalborg rain alerts",
        "emailType": "text",
        "message": "={{ 'You asked to receive Aalborg rain alerts.\\n\\nConfirm your email using the button on this page (link expires in 24 hours):\\nhttps://n8n.automate.business.aau.dk/webhook/aalborg-rain-manage-v1?action=confirm&token=' + $json.confirm_token + '\\n\\nWe check hourly and send an alert when an hour in the next six hours has at least a 60% chance of precipitation and at least 0.2 mm of rain/shower forecast. Maximum one alert per six hours.\\n\\nIf you did not request this, ignore this email.\\nWeather data: Open-Meteo.' }}",
        "options": {
          "appendAttribution": false,
          "senderName": "Aalborg Rain"
        }
      },
